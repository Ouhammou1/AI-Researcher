print(flat_start)
print(flat_start.shape)
print()

t_view =  flat_start.view(4,2)
print(t_view)

print()
print("View shapes memory")
print()
print(f"t_view[0,0] = {t_view[0, 0]}")
t_view[0,0] = 1334
print()

print(t_view)




